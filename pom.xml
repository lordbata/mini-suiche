<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM "padre" (multi-módulo). Agrupa los dos microservicios para compilarlos
  juntos con un solo comando: mvn clean verify
  Cada microservicio sigue siendo independiente: su propio JAR, su propia
  imagen Docker y su propio Deployment en Kubernetes.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.minisuiche</groupId>
    <artifactId>mini-suiche</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mini-suiche</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>card-vault-service</module>
        <module>payment-service</module>
    </modules>
</project>
